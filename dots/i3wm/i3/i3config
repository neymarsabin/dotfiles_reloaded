# works well with pipewire, pavucontrol -> command line version called ~pactl~
# i am not using pulseaudio, because pipewire is a well maintained wrapper around pulseaudio
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec pactl set-sink-volume @DEFAULT_SINK@ 0

# increase and decrease brightness
bindsym XF86MonBrightnessUp exec $scripts_dir/brightness.sh inc
bindsym XF86MonBrightnessDown exec $scripts_dir/brightness.sh dec

# i3lock status
bindsym $mod+shift+x exec i3lock-fancy-multimonitor -n -p

# new window 1 pixel or disabling title bar
